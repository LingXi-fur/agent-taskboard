include LICENSE
include README.md
include README.zh-CN.md
include pyproject.toml
recursive-include src *.py
recursive-include src/agent_taskboard/web *
prune tests
prune examples
prune docs
prune .taskboard
prune .github
exclude DESIGN.md CONTRIBUTING.md CHANGELOG.md
global-exclude *.pyc *.pyo __pycache__ .DS_Store
